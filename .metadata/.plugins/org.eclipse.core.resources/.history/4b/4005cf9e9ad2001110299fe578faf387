server:
  port: 8081

spring:
  application:
    name: API-GATEWAY
  logging:
     file:
        # Resolves to: ./logs/booking-service/booking-service.log
        name: logs/${spring.application.name}/${spring.application.name}.log
     logback:
        rollingpolicy:
          # Pattern for archived daily rolling logs
          file-name-pattern: logs/${spring.application.name}/archived/${spring.application.name}-%d{yyyy-MM-dd}.%i.log.gz
          max-file-size: 10MB
          max-history: 15
          total-size-cap: 1GB
     pattern:
        console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
        file: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
  cloud:
    gateway:
      routes:
        # Route 1: Booking Service
        - id: booking-service-route
          uri: ${BOOKING_SERVICE_URL:http://localhost:8082}
          predicates:
            - Path=/api/v1/bookings/**

        # Route 2: Seat Allocation Service
        - id: seat-allocaton-service-route
          uri: ${SEAT_ALLOCATION_SERVICE_URL:http://localhost:8083}
          predicates:
            - Path=/api/v1/seats/**

        # Route 3: Payment Service (if external direct access is needed)
        - id: payment-service-route
          uri: ${PAYMENT_SERVICE_URL:http://localhost:8084}
          predicates:
            - Path=/api/v1/payments/**

        # Route 4: Saga Orchestrator Service
        - id: saga-orchestrator-route
          uri: ${SAGA_ORCHESTRATOR_SERVICE_URL:http://localhost:8085}
          predicates:
            - Path=/api/v1/sagas/**
         
        # Route 5: Show Service
        - id: show-service-route
          uri: ${SHOW_SERVICE_URL:http://localhost:8086}
          predicates:
            - Path=/api/v1/shows/**
        # Route 6: User Service
        - id: user-service-route
          uri: ${USER_SERVICE_URL:http://localhost:8087}
          predicates:
            - Path=/api/v1/users/**

      # Global CORS Configuration for Web Frontends (Angular, React)
      globalcors:
        cors-configurations:
          '[/**]':
            allowedOrigins:
              - "http://localhost:4200"
              - "http://localhost:3000"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
            allowedHeaders:
              - "*"
            allowCredentials: true

# Monitoring Gateway Status
management:
  endpoints:
    web:
      exposure:
        include: health,info,gateway
  endpoint:
    gateway:
      enabled: true
eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka/