package org.vedantacomp.seat.client;

import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.stereotype.Component;
import org.vedantacomp.seat.dto.SeatAllocationCommand;
import org.vedantacomp.seat.dto.SeatDto;
import org.vedantacomp.seat.dto.SeatStatus;
import org.vedantacomp.seat.service.SeatService;

import lombok.extern.slf4j.Slf4j;

@RequiresArgsConstructor
@Slf4j
@Component
public class SeatSagaOrchestratorListener {

	private final KafkaTemplate<String, Object> kafkaTemplate;
	private final SeatService seatService;
	
	// 1. Listen to the seat allocation topic for Saga orchestration commands
	public void handleSeatAllocationCommand(SeatAllocationCommand command) {
		log.info("Received seat allocation command: {}", command);
		SeatDto seatDto = SeatDto.builder()
				.UUID(command.sagaId())
				.bookingId(command.bookingId())
				.showId(command.showId())
				.seatNumber(command.seatNumber())
				.status(SeatStatus.PENDING) // Assuming the status is set to ALLOCATED upon creation
				.build();
		seatService.createSeat(command);
	}
}
