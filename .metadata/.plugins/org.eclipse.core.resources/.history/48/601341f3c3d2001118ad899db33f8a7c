	public static final BigDecimal MAX_TRANSACTION_LIMIT = new BigDecimal(1000); // Example limit for demonstration	
	@Override
	@Transactional
	public void createPayment(PaymentDto paymentDto) {
		log.info("Creating payment for bookingId: {}", paymentDto.getBookingId());
		String transactionId = "TXN-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase();
		paymentDto.setTransactionId(transactionId);
		PaymentResult paymentResult = executePaymentWithGateway(paymentDto);
		if(paymentResult.success()) {
			log.info("Payment successful for bookingId: {}, transactionId: {}", paymentDto.getBookingId(), transactionId);
			// 1. CREATE a new payment record in the database
			Payment payment = paymentMapper.toEntity(paymentDto);
			payment.setTransactionId(transactionId);
			payment.setStatus(PaymentStatus.COMPLETED); // Assuming payment is completed for simplicity
			paymentRepository.save(payment);
		} else {
			log.error("Payment failed for bookingId: {}, transactionId: {}. Reason: {}", paymentDto.getBookingId(), transactionId, paymentResult.message());
			throw new RuntimeException("Payment processing failed: " + paymentResult.message());
		}
		

