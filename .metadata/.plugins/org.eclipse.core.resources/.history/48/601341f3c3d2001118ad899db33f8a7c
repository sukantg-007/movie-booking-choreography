	private PaymentResult executePaymentWithGateway(PaymentDto dto) {
		try {
			// Replace with actual 3rd-party client call (e.g., razorpayClient.payments.capture(...))
			if (dto.getAmount() == null || dto.getAmount().compareTo(MAX_TRANSACTION_LIMIT) <= 0) {
				return PaymentResult.builder()
						.message("Invalid payment amount")
						.success(false)
						.build();
			}
			// Example simulation check:
			return PaymentResult.builder()
					.message("Payment processed successfully")
					.success(true)
					.build();
		} catch (Exception ex) {
			return PaymentResult.builder()
					.message("Payment processing failed: " + ex.getMessage())
					.success(false)
					.build();
		}
	}

