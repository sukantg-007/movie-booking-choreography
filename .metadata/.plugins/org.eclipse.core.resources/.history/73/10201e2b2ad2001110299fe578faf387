	@Override
	@Transactional
	public void handleBookingCreatedEvent(BookingCreatedEvent event) {
		log.info("Handling booking created event: {}", event);
		//1. GET BOOKINGID, USERID, SHOWID, SEATNUMBER, AMOUNT FROM THE BOOKING CREATED EVENT
		//2. CREATE A SAGA RECORD IN THE SAGA TABLE WITH STATUS AS "BOOKING_CREATED"
		Saga saga = new Saga();
		saga.setBookingId(event.bookingId());
		saga.setUserId(event.userId());
		saga.setShowId(event.showId());
		saga.setSeatNumber(event.seatNumber());
		saga.setAmount(event.amount());
		saga.setStatus(SagaOrchestratorStatus.BOOKING_CREATED);
		sagaRepository.save(saga);
		
		log.info("Saga record created with booking id: {} with status: {}", saga.getBookingId(), saga.getStatus());		
		
		//3. PUBLISH SEAT ALLOCATION COMMAND TO THE SEAT ALLOCATION SERVICE
		commandPublisher.publishSeatAllocationCommand(
				SeatAllocationCommand.builder()
				.sagaId(saga.getId())
				.bookingId(saga.getBookingId())
				.userId(saga.getUserId())
				.showId(saga.getShowId())
				.seatNumber(saga.getSeatNumber())
				.amount(saga.getAmount())
				.build()
				);
	}

}
