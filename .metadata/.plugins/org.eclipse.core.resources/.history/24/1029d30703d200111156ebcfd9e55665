package org.vedantacomp.booking.service;

import java.time.LocalDateTime;

import org.springframework.stereotype.Service;
import org.vedantacomp.booking.client.KafkaPublisherService;
import org.vedantacomp.booking.dto.BookingCreatedEvent;
import org.vedantacomp.booking.dto.BookingDto;
import org.vedantacomp.booking.entity.Booking;
import org.vedantacomp.booking.entity.BookingStatus;
import org.vedantacomp.booking.mapper.BookingMapper;
import org.vedantacomp.booking.repository.BookingRepository;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@RequiredArgsConstructor
@Slf4j
@Service
public class BookingServiceImpl implements BookingService {
	private final BookingRepository bookingRepository;
    private final BookingMapper bookingMapper;
    private final KafkaPublisherService kafkaPublisherService;
    
    
	@Override
	public BookingDto createBooking(BookingDto bookingDto) {
		// 1. Convert BookingDto to Booking entity
		Booking booking = bookingMapper.toEntity(bookingDto);
		//2. Save the Booking entity to the database
		booking.setStatus(BookingStatus.PENDING);
		Booking savedBooking = bookingRepository.save(booking);
		//3. Convert the saved Booking entity back to BookingDto
		BookingDto savedBookingDto = bookingMapper.toDto(savedBooking);
		//4. Publish the booking event to Kafka
		kafkaPublisherService.publishBookingCreatedEvent(
				BookingCreatedEvent.builder()
				.bookingId(savedBooking.getId())
				.userId(savedBooking.getUserId())
				.seatNumber(savedBooking.getSeatNumber())
				.amount(savedBooking.getAmount())
				.build()
	        );
		log.info("Booking created and event published to Kafka for bookingId: {}", savedBooking.getId());
		//5. Return the saved BookingDto
		return bookingMapper.toDto(savedBooking);
	}

	@Override
	public BookingDto getBookingById(Long id) {
		// TODO Auto-generated method stub
		return null;
	}

	@Override
	public void updateBookingStatus(Long bookingId, String status) {
		// 1. Retrieve the booking entity from the database using the bookingId
		// 2. Update the status of the booking entity
		// 3. Save the updated booking entity back to the database
		Booking booking = bookingRepository.findById(bookingId)
				.orElseThrow(() -> new RuntimeException("Booking not found for id: " + bookingId));
		booking.setStatus(status);
		bookingRepository.save(booking);
		
	}

}
