server:
  port: 8087
spring:
  application:
    name: USER-SERVICE
  logging:
     file:
          # Resolves to: ./logs/booking-service/booking-service.log
          name: logs/${spring.application.name}/${spring.application.name}.log
     logback:
          rollingpolicy:
            # Pattern for archived daily rolling logs
            file-name-pattern: logs/${spring.application.name}/archived/${spring.application.name}-%d{yyyy-MM-dd}.%i.log.gz
            max-file-size: 10MB
            max-history: 15
            total-size-cap: 1GB
     pattern:
          console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
          file: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"

  datasource:
    url: jdbc:postgresql://localhost:5432/showdb
    username: postgres
    password: Sukantg#007
    driver-class-name: org.postgresql.Driver
  jpa:
    database-platform: org.hibernate.dialect.PostgreSQLDialect
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate: format_sql:true
      dialect: org.hibernate.dialect.PostgreSQLDialect
eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka/

