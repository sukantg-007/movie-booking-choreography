package org.vedantacomp.booking.client;

import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Component;
import org.vedantacomp.booking.dto.SagaFinalCommand;
import org.vedantacomp.booking.service.BookingService;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@RequiredArgsConstructor
@Component
public class BookingSagaOrchestratorListener {
	
	private final BookingService bookingService;

	@KafkaListener(topics = "saga-final-command-topic", groupId = "booking-service-group")
	public void handleSagaFinalCommand(SagaFinalCommand command) {
		log.info("Received SagaFinalCommand for bookingId: {}, status: {}", command.bookingId(), command.status());
		// Update the booking status in the database
		bookingService.updateBookingStatus(command);
	}
}
